<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7FCF9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="60dp">

        <!-- 뒤로가기 버튼 -->
        <Button
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="←"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#66B375"
            app:cornerRadius="24dp"
            android:padding="0dp"
            android:layout_marginBottom="40dp"/>

        <!-- 위치 등록 타이틀 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="위치 등록하기"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"/>

        <!-- 위치 등록 박스 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/border_box"
            android:padding="16dp"
            android:layout_marginBottom="15dp">

            <TextView
                android:id="@+id/txtSelectedAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="이곳을 터치하여 주소를 검색하세요"
                android:background="@drawable/rounded_white_bg"
                android:textSize="14sp"
                android:textColor="#555555"
                android:padding="10dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="별명 : "
                    android:textSize="14sp"
                    android:textColor="#000000"/>

                <EditText
                    android:id="@+id/editNickname"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="별명을 입력하세요 (예: 집, 학교)"
                    android:textSize="14sp"
                    android:inputType="text"/>

            </LinearLayout>

            <Button
                android:id="@+id/btnRegister"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:backgroundTint="#66B375"
                android:text="위치 등록하기"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- 현재 등록된 위치 타이틀 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="현재 등록된 위치"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:layout_marginBottom="8dp"/>

        <!-- 현재 등록된 위치 박스 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/border_box"
            android:padding="16dp">

            <!-- 동적으로 채워질 위치 목록 컨테이너 -->
            <LinearLayout
                android:id="@+id/locationsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="8dp"/>

            <!-- 빈 상태 메시지 -->
            <TextView
                android:id="@+id/txtEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="등록된 위치가 없습니다."
                android:textSize="14sp"
                android:textColor="#999999"
                android:gravity="center"
                android:padding="16dp"
                android:visibility="gone"/>

            <!-- 하단 버튼 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <Button
                    android:id="@+id/btnEditNickname"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="별명 수정하기"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#66B375"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <Button
                    android:id="@+id/btnDeleteLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="위치 삭제하기"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#FF8484"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
