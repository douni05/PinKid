<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7FCF9">

    <TextView
        android:id="@+id/txtPinKid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PinKid"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#2D7A4F"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="80dp"/>

    <TextView
        android:id="@+id/txtSubTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="우리 아이가 있는 곳, 언제나 함께"
        android:textSize="14sp"
        android:textColor="#5AAB78"
        app:layout_constraintTop_toBottomOf="@id/txtPinKid"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <View
        android:id="@+id/divider"
        android:layout_width="48dp"
        android:layout_height="4dp"
        android:background="#66B375"
        app:layout_constraintTop_toBottomOf="@id/txtSubTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"/>

    <TextView
        android:id="@+id/txtID"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="이메일"
        android:textSize="12sp"
        android:textColor="#3D8C5C"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintStart_toStartOf="@id/editTxtID"
        android:layout_marginTop="32dp"/>

    <EditText
        android:id="@+id/editTxtID"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="이메일을 입력하세요"
        android:inputType="textEmailAddress"
        android:textSize="14sp"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/txtID"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginTop="6dp"/>

    <TextView
        android:id="@+id/txtPassword"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="비밀번호"
        android:textSize="12sp"
        android:textColor="#3D8C5C"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/editTxtID"
        app:layout_constraintStart_toStartOf="@id/editTxtPW"
        android:layout_marginTop="16dp"/>

    <EditText
        android:id="@+id/editTxtPW"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="비밀번호를 입력하세요"
        android:inputType="textPassword"
        android:textSize="14sp"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/txtPassword"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginTop="6dp"/>

    <!-- 보안 문자 라벨 -->
    <TextView
        android:id="@+id/txtCaptchaLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="보안 문자"
        android:textSize="12sp"
        android:textColor="#3D8C5C"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/editTxtPW"
        app:layout_constraintStart_toStartOf="@id/captchaCard"
        android:layout_marginTop="20dp"/>

    <!-- 캡챠 표시 카드 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/captchaCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#D6EFD8"
        app:cardCornerRadius="10dp"
        app:cardElevation="2dp"
        app:layout_constraintTop_toBottomOf="@id/txtCaptchaLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/txtCaptcha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="A3K9P"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#2D7A4F"
            android:fontFamily="monospace"
            android:letterSpacing="0.5"
            android:gravity="center"
            android:padding="16dp"/>

    </androidx.cardview.widget.CardView>

    <!-- 새로고침 버튼 (카드 오른쪽 아래) -->
    <TextView
        android:id="@+id/btnRefreshCaptcha"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="↻ 새로고침"
        android:textSize="12sp"
        android:textColor="#66B375"
        android:padding="4dp"
        app:layout_constraintTop_toBottomOf="@id/captchaCard"
        app:layout_constraintEnd_toEndOf="@id/captchaCard"
        android:layout_marginTop="4dp"/>

    <!-- 캡챠 입력 -->
    <EditText
        android:id="@+id/editTxtCaptcha"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="위 문자를 입력하세요"
        android:inputType="textCapCharacters"
        android:textSize="14sp"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/btnRefreshCaptcha"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginTop="4dp"/>

    <Button
        android:id="@+id/btnLogin"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="로그인"
        android:textSize="15sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#66B375"
        app:layout_constraintTop_toBottomOf="@id/editTxtCaptcha"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginTop="24dp"/>

    <Button
        android:id="@+id/btnSignUp"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="회원가입"
        android:textSize="15sp"
        android:textColor="#66B375"
        android:backgroundTint="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/btnLogin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginTop="12dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
